{
  "manifest_version": 3,
  "name": "MendoSave",
  "version": "0.4.0",
  "description": "Локальное сохранение фото, видео, аудио и субтитров. Выбор форматов, пакеты и ZIP.",
  "permissions": [
    "downloads",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://i.ytimg.com/*",
    "https://rutube.ru/*",
    "https://rutube.sport/*",
    "https://*.rutube.ru/*",
    "https://*.rtbcdn.ru/*",
    "https://coub.com/*",
    "https://*.coub.com/*",
    "https://vkvideo.ru/*",
    "https://*.vkvideo.ru/*",
    "https://vk.com/*",
    "https://zvuk.com/*",
    "https://*.zvuk.com/*",
    "https://www.tiktok.com/*",
    "https://*.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktokcdn-eu.com/*",
    "https://*.tiktokv.com/*",
    "https://*.tiktokv.us/*",
    "https://*.byteoversea.com/*",
    "https://*.ibyteimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["menu.js", "package_queue.js", "package_ui.js", "instagram_source.js", "instagram_bridge.js", "instagram_media.js", "instagram.js"],
      "css": ["package_ui.css", "instagram.css", "ui.css"],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "captions.js",
        "content_hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "menu.js",
        "package_queue.js",
        "package_ui.js",
        "settings.js",
        "diagnostics.js",
        "media_plan.js",
        "content_ui.js"
      ],
      "css": [
        "package_ui.css",
        "content_ui.css",
        "ui.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://rutube.ru/*",
        "https://rutube.sport/*"
      ],
      "js": [
        "menu.js",
        "package_queue.js",
        "package_ui.js",
        "rutube.js"
      ],
      "css": [
        "package_ui.css",
        "rutube.css",
        "ui.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*"
      ],
      "js": [
        "menu.js",
        "package_queue.js",
        "package_ui.js",
        "settings.js",
        "twitch_ui.js"
      ],
      "css": [
        "package_ui.css",
        "twitch_ui.css",
        "ui.css"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://coub.com/*"
      ],
      "js": [
        "menu.js",
        "package_queue.js",
        "package_ui.js",
        "coub.js"
      ],
      "css": [
        "package_ui.css",
        "coub.css",
        "ui.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://vkvideo.ru/video_ext.php*",
        "https://*.vkvideo.ru/video_ext.php*",
        "https://vk.com/video_ext.php*"
      ],
      "js": [
        "vk_source.js",
        "vk_bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://vkvideo.ru/*",
        "https://*.vkvideo.ru/*",
        "https://vk.com/video*",
        "https://vk.com/clip*"
      ],
      "js": [
        "menu.js",
        "package_queue.js",
        "package_ui.js",
        "vk_source.js",
        "vk.js"
      ],
      "css": [
        "package_ui.css",
        "vk.css",
        "ui.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://zvuk.com/*"
      ],
      "js": [
        "menu.js",
        "package_queue.js",
        "package_ui.js",
        "zvuk.js"
      ],
      "css": [
        "package_ui.css",
        "zvuk.css",
        "ui.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "menu.js",
        "package_queue.js",
        "package_ui.js",
        "tiktok.js"
      ],
      "css": [
        "package_ui.css",
        "tiktok.css",
        "ui.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/mediabunny/mediabunny.min.mjs"],
      "matches": ["https://www.instagram.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
