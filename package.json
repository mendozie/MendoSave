{
  "name": "mendosave",
  "version": "0.3.3",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs scripts/check-tools.test.cjs",
    "build": "node scripts/build.cjs",
    "lint:js": "eslint extension browser-hosts scripts tests eslint.config.cjs",
    "check:build": "node scripts/check-build.cjs",
    "check:outgoing": "node scripts/check-outgoing.cjs --all",
    "check:dependencies": "node scripts/check-dependencies.cjs",
    "audit:dependencies": "node scripts/check-dependencies.cjs --audit",
    "check:extension": "node scripts/check-extension.cjs",
    "prepare:release": "node scripts/release.cjs",
    "verify": "node scripts/verify.cjs",
    "lint:extension": "web-ext lint --source-dir dist/firefox",
    "lint:extension:strict": "web-ext lint --source-dir dist/firefox --warnings-as-errors"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "linkedom": "0.18.12",
    "web-ext": "10.7.0"
  },
  "overrides": {
    "fx-runner": {
      "shell-quote": "1.11.0"
    }
  }
}
